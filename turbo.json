{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/README.md", "$TURBO_ROOT$/LICENSE", "$TURBO_ROOT$/docs/**"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": ["NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "AI_GATEWAY_API_KEY",
        "NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^build", "^type-check"]
    },
    "clean": {
      "cache": false
    }
  }
}
