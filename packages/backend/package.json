{
  "name": "@intent-driven-interface/backend",
  "version": "0.1.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api-contracts": {
      "types": "./dist/api-contracts.d.ts",
      "default": "./dist/api-contracts.js"
    },
    "./trim-messages-for-agent": {
      "types": "./dist/trim-messages-for-agent.d.ts",
      "default": "./dist/trim-messages-for-agent.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "prepack": "turbo run build --filter=@intent-driven-interface/backend",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@futuristic.digital/logger": "^0.1.1",
    "ai": "^7.0.173",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
