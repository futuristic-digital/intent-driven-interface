{
  "name": "@intent-driven-interface/frontend",
  "version": "0.1.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "prepack": "turbo run build --filter=@intent-driven-interface/frontend",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.177",
    "@intent-driven-interface/backend": "^0.1.1",
    "ai": "^7.0.173",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "react": "^19.3.1",
    "typescript": "^5"
  }
}
