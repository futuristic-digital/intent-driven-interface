{
  "name": "intent-driven-interface",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:demo": "turbo run dev --filter=demo...",
    "build:demo": "turbo run build --filter=demo",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "publish:packages": "npm-publish",
    "publish:check": "npm-publish --check-only"˝
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@futuristic.digital/npm-publish": "^0.1.0",
    "@types/node": "^25.9.9",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.11.0"
  },
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "ai": "^7.0.156",
    "zod": "4.6.7"
  }
}
